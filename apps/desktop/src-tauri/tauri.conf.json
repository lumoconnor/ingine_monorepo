{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ingine World",
  "version": "0.1.0",
  "identifier": "com.lumoconnor.ingine.world",
  "build": {
    "beforeDevCommand": "npm run dev -w @ingine/sandbox",
    "devUrl": "http://localhost:5173/?level=world",
    "beforeBuildCommand": "npm run build:desktop -w @ingine/sandbox",
    "frontendDist": "../../sandbox/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ingine World",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Procedural first-person open world (prototype)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
